{
  "name": "ryuei",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:wifi": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4196 --strictPort",
    "test": "vitest run",
    "check:assets": "node scripts/audit-assets.mjs",
    "format": "prettier --write src tests scripts docs *.json *.md *.html *.ts",
    "build:pages": "tsc -b && vite build --base=/RYUEI/ --outDir=dist-pages"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
